<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- LibraryImport source-gen + the byte* fast path in RfcommClient need unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>L13.Core</RootNamespace>
    <AssemblyName>L13.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls the Windows Desktop shared framework so the library can use
         System.Drawing (GDI+) without a separate NuGet package. Version-agnostic. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
